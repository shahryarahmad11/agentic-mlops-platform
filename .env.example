# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider (the key is a secret; set it only in your local .env)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=30
GEMINI_API_KEY=replace-me

# Airflow API (the password is a secret; set it only in your local .env)
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=replace-me

# MLflow tracking server
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Kubernetes (the agent may only touch these namespaces)
K8S_NAMESPACE=mlops
K8S_ALLOWED_NAMESPACES=mlops
# Optional: restricted ServiceAccount kubeconfig created by scripts/agent_kubeconfig.sh
# KUBECONFIG=/home/<you>/.kube/mlops-agent.kubeconfig

# Agent behaviour and retraining policy
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=20
TOOL_TIMEOUT_SECONDS=20
MODEL_MAX_AGE_DAYS=30
